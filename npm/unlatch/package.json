{
  "name": "unlatch",
  "version": "0.1.0-alpha.1",
  "description": "Your cloud VM's files in macOS Finder, as snappy as a local folder, for people who run Claude Code or Codex on remote VMs. Pre-release: the Linux VM daemon and Linux FUSE client work; the Mac app is not published yet.",
  "keywords": [
    "ssh",
    "vm",
    "finder",
    "file-provider",
    "fuse",
    "remote-development",
    "claude-code",
    "codex",
    "sync"
  ],
  "homepage": "https://github.com/sudhanshuheda/unlatch#readme",
  "bugs": {
    "url": "https://github.com/sudhanshuheda/unlatch/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sudhanshuheda/unlatch.git",
    "directory": "npm/unlatch"
  },
  "license": "MIT OR Apache-2.0",
  "bin": {
    "unlatch": "bin/unlatch.js"
  },
  "main": "lib/cli.js",
  "files": [
    "bin/",
    "lib/",
    "skill/",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "optionalDependencies": {
    "unlatch-darwin-universal": "0.1.0-alpha.1",
    "unlatch-linux-arm64": "0.1.0-alpha.1",
    "unlatch-linux-x64": "0.1.0-alpha.1"
  }
}
